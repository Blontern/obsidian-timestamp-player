{
  "name": "timestamp-player",
  "version": "1.1.0",
  "description": "Click timestamps in transcription documents to seek and play the embedded audio",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "audio",
    "timestamp",
    "transcription"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
